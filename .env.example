# ---- Database ----
# Local development: a SQLite file, no database server needed.
DATABASE_URL="file:./dev.db"

# Cloud: Turso (hosted libSQL). When TURSO_DATABASE_URL is set, the app and scripts use Turso
# instead of the local file. Create with: turso db create quarters && turso db tokens create quarters
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# ---- Data mode ----
# demo = fictional seeded companies only, with a DEMO banner on every page.
# live = only records imported from real sources.
DATA_MODE="demo"

# ---- Upstox (server-side only; never prefix with NEXT_PUBLIC_) ----
# Analytics token from https://account.upstox.com/developer/apps → Analytics tab. Valid 1 year.
UPSTOX_ANALYTICS_TOKEN=""
# Keep false until Upstox confirms IN WRITING that its data may be shown to public visitors.
PUBLIC_DISPLAY_UPSTOX="false"

# ---- TejHQ (optional, personal-use free key; cross-checking only) ----
TEJHQ_API_KEY=""
